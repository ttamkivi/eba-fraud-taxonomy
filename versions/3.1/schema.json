{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EBA Fraud Taxonomy 3.1: fraud case classification record",
  "description": "Validates one fraud-case classification against the EBA Fraud Taxonomy v3.1. The permitted codes are generated from taxonomy.json by build_schema.py.",
  "type": "object",
  "required": [
    "taxonomy_version",
    "method_code",
    "modus_code",
    "initiator_code"
  ],
  "properties": {
    "taxonomy_version": {
      "type": "string",
      "const": "3.1",
      "description": "Taxonomy version the record was classified under. Always store it: entries are added, split, moved and retired between versions."
    },
    "method_code": {
      "type": "string",
      "enum": [
        "T0001",
        "T0002",
        "T0003",
        "T0004",
        "T0005",
        "T0006",
        "T0007",
        "T0008",
        "T0009",
        "T0010",
        "T0011",
        "T0012",
        "T0013",
        "T0014",
        "T0015",
        "T0016",
        "T0017"
      ],
      "description": "Method (how) as a code. Canonical machine value."
    },
    "method": {
      "type": "string",
      "enum": [
        "Brute force",
        "Data breach / theft",
        "E-mail compromise",
        "E-mail contact",
        "Fake advertising",
        "Fake merchant",
        "In person contact",
        "Malware",
        "Man in the middle",
        "Online contact",
        "Phone contact",
        "Physical copy",
        "Physical theft",
        "Social media compromise",
        "Social media contact",
        "Text message contact",
        "New method"
      ],
      "description": "Optional display label for method_code. Not a source of truth."
    },
    "method_new_description": {
      "type": "string",
      "description": "Required free text when method_code is T0017 (New method)."
    },
    "modus_code": {
      "type": "string",
      "enum": [
        "T0019",
        "T0020",
        "T0022",
        "T0023",
        "T0025",
        "T0027",
        "T0029",
        "T0031",
        "T0033",
        "T0034",
        "T0036",
        "T0038",
        "T0039",
        "T0041",
        "T0042",
        "T0043",
        "T0044",
        "T0045",
        "T0046",
        "T0047",
        "T0048"
      ],
      "description": "Modus (what) as a code. Canonical machine value."
    },
    "modus": {
      "type": "string",
      "enum": [
        "Safe account fraud",
        "Stop unauthorised transaction fraud",
        "Advance fee fraud",
        "Investment fraud",
        "Online shopping fraud",
        "Emotional manipulation",
        "Extortion",
        "Impersonation of creditor",
        "Overpayment scams",
        "Phoney debt/bill collection",
        "Fake institution",
        "Pure account takeover",
        "Creditor account data manipulation",
        "Card details stolen",
        "Card lost or stolen",
        "Card never received",
        "Use of counterfeit cards",
        "Fraudulent card application",
        "Fraudulent card claim",
        "Fraudulent use of cash back scheme",
        "New fraud type (describe)"
      ],
      "description": "Optional display label for modus_code. Not a source of truth."
    },
    "modus_new_description": {
      "type": "string",
      "description": "Required free text when modus_code is T0048 (New fraud type (describe))."
    },
    "initiator_code": {
      "type": "string",
      "enum": [
        "T0049",
        "T0050",
        "T0051"
      ],
      "description": "Initiator (who) as a code. Canonical machine value."
    },
    "initiator": {
      "type": "string",
      "enum": [
        "Customer",
        "Fraudster",
        "First party"
      ],
      "description": "Optional display label for initiator_code. Not a source of truth."
    },
    "labels_tags_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Labels/tags (what else) as codes. Deliberately unconstrained: the taxonomy states that its labels are suggestions and PSPs may add their own. Values of the form T followed by four digits should resolve to taxonomy.json; anything else is institution-specific."
    },
    "labels_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Optional display labels for labels_tags_codes."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "method_code": {
            "const": "T0017"
          }
        },
        "required": [
          "method_code"
        ]
      },
      "then": {
        "required": [
          "method_new_description"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "modus_code": {
            "const": "T0048"
          }
        },
        "required": [
          "modus_code"
        ]
      },
      "then": {
        "required": [
          "modus_new_description"
        ]
      }
    }
  ],
  "additionalProperties": true
}
